<html>

<head>
    <title>
        Mini Message Board
    </title>
    <link rel="stylesheet" href="styles.css">
</head>

<body>
    <div class="header">
        <header>
            <h2>
                Mini Message Board
            </h2>
        </header>
    </div>
    <div class="container">
        <% for(let i=0; i < messages.length; i++) { %>
            <div class="message">
                <%= messages[i].text%> <br>
                    <%= messages[i].user%> <br>
                        <%= messages[i].added%>

            </div>
            <a href="<%= `/message/${i + 1}` %>" id="open">Open</a>
            <% }%>

                <div class="link">
                    <a href="/new">New Message</a>
                </div>
    </div>

</body>

</html>