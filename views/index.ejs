<html>

<head>
    <title>
        Mini Message Board
    </title>
    <link rel="stylesheet" href="styles.css">
</head>

<body>
    <div class="header">
        <header>
            <h2>
                Mini Message Board
            </h2>
        </header>
    </div>
    <div class="container">
        <% messages.map((msg)=> { %>
            <div class="message">
                <%= msg.text%> <br>
                    <%= msg.user%> <br>
                        <%= msg.added%>

            </div>
            <% }) %>

                <div class="link">
                    <a href="/new">New Message</a>
                </div>
    </div>

</body>

</html>