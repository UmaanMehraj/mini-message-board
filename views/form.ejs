<html>

<head>
    <title>Form</title>
</head>
<h2>
    New Message
</h2>
<form action="/new" method="post">
    <label for="authorName">
        <input type="text" name="authorName" id="authorName" placeholder="Name">
    </label>
    <label for="message">
        <textarea name="message" id="message" placeholder="Enter your messag"></textarea>
    </label>
    <button type="submit">Submit</button>
</form>

</html>